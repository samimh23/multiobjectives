    "    ax1.legend(loc='best', fontsize=10)\n",
    "    ax1.grid(True, alpha=0.3)\n",
    "    \n",
    "    # ========== SUBPLOT 2: All Solutions ==========\n",
    "    ax2 = fig.add_subplot(1, 3, 2)\n",
    "    \n",
    "    ax2.scatter(baseline_all[:, 0], baseline_all[:, 1], \n",
