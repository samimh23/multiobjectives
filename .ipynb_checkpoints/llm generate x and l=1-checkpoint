    "    \n",
    "    # ========== SUBPLOT 3: Statistics ==========\n",
    "    ax3 = fig.add_subplot(1, 3, 3)\n",
    "    ax3.axis('off')\n",
    "    \n",
    "    # Calculate metrics\n",
    "    ref_point = [0, 0]  # For hypervolume (nadir point)\n",
