    "    if not baseline_points or not hybrid_points:\n",
    "        print(\"❌ Cannot load data files\")\n",
    "        return\n",
    "    \n",
    "    # Extract Pareto fronts\n",
    "    baseline_pareto = get_pareto_front(baseline_points)\n",
    "    hybrid_pareto = get_pareto_front(hybrid_points)\n",
