    "import matplotlib.pyplot as plt\n",
    "\n",
    "# --- Functions for analysis (same as before) ---\n",
    "def dominates(a, b):\n",
    "    return all(x >= y for x, y in zip(a, b)) and any(x > y for x, y in zip(a, b))\n",
    "\n",
    "def get_true_pareto_front(points):\n",
    "    pareto = []\n",
    "    for i, p in enumerate(points):\n",
    "        dominated = False\n",
    "        for j, q in enumerate(points):\n",
    "            if i != j and dominates(q, p):\n",
    "                dominated = True\n",
    "                break\n",
    "        if not dominated:\n",
    "            pareto.append(p)\n",
    "    return pareto\n",
    "\n",
    "def report_pareto_stats(filename, label):\n",
    "    points = []\n",
    "    with open(filename, \"r\") as f:\n",
    "        for line in f:\n",
    "            line = line.strip()\n",
    "            if line:\n",
    "                try:\n",
    "                    points.append([float(x) for x in line.split()])\n",
    "                except Exception:\n",
    "                    pass\n",
    "    total_points = len(points)\n",
    "    pareto_front = get_true_pareto_front(points)\n",
    "    num_pareto = len(pareto_front)\n",
    "    print(f\"--- {label} ---\")\n",
    "    print(f\"  Total points: {total_points}\")\n",
    "    print(f\"  Pareto-optimal points: {num_pareto}\")\n",
    "    return pareto_front\n",
    "\n",
    "def plot_pareto_fronts(fronts, labels, title):\n",
    "    plt.figure(figsize=(10, 7))\n",
    "    for front, label in zip(fronts, labels):\n",
    "        if not front: continue\n",
    "        xs, ys = zip(*front)\n",
    "        plt.scatter(xs, ys, label=label, alpha=0.7)\n",
    "    plt.xlabel(\"Objective 1 (Profit)\")\n",
    "    plt.ylabel(\"Objective 2 (Profit)\")\n",
    "    plt.title(title)\n",
    "    plt.legend()\n",
    "    plt.grid(True)\n",
    "    plt.show()\n",
    "\n",
    "# --- Comparison ---\n",
    "BASELINE_FILE = \"2502_ResultsMD.txt\"\n",
    "HYBRID_FILE = \"2502_Results_HYBRID.txt\"\n",
    "\n",
    "print(\"Comparing Baseline vs. Hybrid Algorithm Results:\\n\")\n",
    "\n",
    "baseline_front = report_pareto_stats(BASELINE_FILE, \"Baseline (Original MOACP)\")\n",
    "hybrid_front = report_pareto_stats(HYBRID_FILE, \"Hybrid (MOACP + LLM)\")\n",
    "\n",
    "# --- Visual Comparison ---\n",
    "plot_pareto_fronts(\n",
    "    fronts=[baseline_front, hybrid_front],\n",
    "    labels=[\"Baseline\", \"Hybrid\"],\n",
    "    title=\"Pareto Front Comparison: Baseline vs. Hybrid Algorithm\"\n",
    ")"
