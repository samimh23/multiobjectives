   "source": [
    "import time\n",
    "import os\n",
    "import ollama\n",
    "import matplotlib.pyplot as plt\n",
    "import csv\n",
    "\n",
    "# ============================================================================\n",
    "# HELPER FUNCTIONS\n",
    "# ============================================================================\n",
    "\n",
    "def python_llm_call(prompt: str) -> str:\n",
    "    \"\"\"Communicates with the local Ollama server.\"\"\"\n",
    "    try:\n",
    "        response = ollama.chat(\n",
    "            model='llama3:8b',\n",
    "            messages=[{'role': 'user', 'content': prompt}]\n",
    "        )\n",
    "        return response['message']['content']\n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error communicating with Ollama: {e}\")\n",
    "        return None\n",
    "\n",
    "\n",
    "def save_llm_metrics(run_num, llm_calls, accepted, rejected, output_file=\"llm_metrics.csv\"):\n",
    "    \"\"\"Save LLM performance metrics to CSV\"\"\"\n",
    "    file_exists = os.path.exists(output_file)\n",
    "    \n",
    "    with open(output_file, 'a', newline='') as f:\n",
    "        writer = csv.writer(f)\n",
    "        if not file_exists:\n",
    "            writer.writerow(['Run', 'LLM_Calls', 'Accepted', 'Rejected', 'Acceptance_Rate'])\n",
    "        \n",
    "        acceptance_rate = 100.0 * accepted / llm_calls if llm_calls > 0 else 0\n",
    "        writer.writerow([run_num, llm_calls, accepted, rejected, f\"{acceptance_rate:.2f}\"])\n",
    "\n",
    "\n",
    "def dominates(a, b):\n",
    "    \"\"\"Check if solution a dominates solution b (maximization)\"\"\"\n",
    "    return all(x >= y for x, y in zip(a, b)) and any(x > y for x, y in zip(a, b))\n",
    "\n",
    "\n",
    "def get_true_pareto_front(points):\n",
    "    \"\"\"Extract non-dominated solutions from a set of points\"\"\"\n",
    "    pareto = []\n",
    "    for i, p in enumerate(points):\n",
    "        dominated = False\n",
    "        for j, q in enumerate(points):\n",
    "            if i != j and dominates(q, p):\n",
    "                dominated = True\n",
    "                break\n",
    "        if not dominated:\n",
    "            pareto.append(p)\n",
    "    return pareto\n",
    "\n",
    "\n",
    "def report_pareto_stats(filename, label):\n",
    "    \"\"\"Load results and compute Pareto front statistics\"\"\"\n",
    "    if not os.path.exists(filename):\n",
    "        print(f\"⚠️  Warning: {filename} not found!\")\n",
    "        return []\n",
    "    \n",
    "    points = []\n",
    "    with open(filename, \"r\") as f:\n",
    "        for line in f:\n",
    "            line = line.strip()\n",
    "            if line:\n",
    "                try:\n",
    "                    points.append([float(x) for x in line.split()])\n",
    "                except Exception:\n",
    "                    pass\n",
    "    \n",
    "    total_points = len(points)\n",
    "    pareto_front = get_true_pareto_front(points)\n",
    "    num_pareto = len(pareto_front)\n",
    "    \n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"{label}\")\n",
    "    print(f\"{'='*60}\")\n",
    "    print(f\"  Total solutions:        {total_points}\")\n",
    "    print(f\"  Pareto-optimal:         {num_pareto}\")\n",
    "    print(f\"  Pareto ratio:           {100*num_pareto/total_points:.2f}%\")\n",
    "    print(f\"{'='*60}\")\n",
    "    \n",
    "    return pareto_front\n",
    "\n",
    "\n",
    "def plot_pareto_fronts(fronts, labels, title, save_path=None):\n",
    "    \"\"\"Visualize and compare Pareto fronts\"\"\"\n",
    "    plt.figure(figsize=(12, 8))\n",
    "    \n",
    "    colors = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728']\n",
    "    markers = ['o', 's', '^', 'D']\n",
    "    \n",
    "    for idx, (front, label) in enumerate(zip(fronts, labels)):\n",
    "        if not front:\n",
    "            print(f\"⚠️  Warning: Empty Pareto front for {label}\")\n",
    "            continue\n",
    "        xs, ys = zip(*front)\n",
    "        plt.scatter(xs, ys, \n",
    "                   label=f\"{label} ({len(front)} solutions)\",\n",
    "                   alpha=0.7, \n",
    "                   s=80,\n",
    "                   color=colors[idx % len(colors)],\n",
    "                   marker=markers[idx % len(markers)],\n",
    "                   edgecolors='black',\n",
    "                   linewidth=0.5)\n",
    "    \n",
    "    plt.xlabel(\"Objective 1 (Profit)\", fontsize=12, fontweight='bold')\n",
    "    plt.ylabel(\"Objective 2 (Profit)\", fontsize=12, fontweight='bold')\n",
    "    plt.title(title, fontsize=14, fontweight='bold', pad=20)\n",
    "    plt.legend(fontsize=11, loc='best')\n",
    "    plt.grid(True, alpha=0.3, linestyle='--')\n",
    "    plt.tight_layout()\n",
    "    \n",
    "    if save_path:\n",
    "        plt.savefig(save_path, dpi=300, bbox_inches='tight')\n",
